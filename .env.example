# Copy this file to .env and fill in your values.

# =============================================================================
# MODE - single switch for dual-mode setup
#   "local" -> local DB + local disk file storage + http://localhost CORS
#   "prod"  -> reads ALL creds from the environment (deployment env vars)
#
#   * In deployment (Render/VPS) leave MODE unset -> defaults to "prod",
#     and set the creds below as environment variables in the dashboard.
#   * Locally, keep MODE=local for zero-config dev.
#   * To simulate prod locally, set MODE=prod and put your real creds in .env.
# =============================================================================
MODE=local

# Server port
PORT=8000

# Allowed origin for CORS
#   local: http://localhost:8000
#   prod:  e.g. https://your-app.onrender.com
CORS_ORIGIN=http://localhost:8000

# MongoDB connection string
#   local: mongodb://localhost:27017  (db name "blog" is appended automatically)
#   prod:  full Atlas string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/blog
DB_URL=mongodb://localhost:27017

# JWT secrets - generate secure random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   local: has hardcoded dev fallbacks, but you can set them here
#   prod:  required (set in deployment env)
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# JWT expiry strings (https://github.com/vercel/ms)
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary credentials (https://cloudinary.com)
#   ONLY used in prod mode. Local mode stores files on local disk (public/uploads).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret