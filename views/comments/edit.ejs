<% layout('/shared/layouts/boilerplate.ejs') -%>
<section class="container-page max-w-2xl py-12">
    <span class="chip">$ vim comment</span>
    <h1 class="type-h2 mt-3">Edit comment</h1>

    <form action="/api/v1/post/comment/edit/<%= comment._id %>" method="POST" data-pending class="card mt-8 space-y-5 p-6 sm:p-8">
        <div>
            <label for="comment" class="label">Your comment</label>
            <textarea id="comment" name="comment" rows="4" required class="input resize-y"><%- comment.content %></textarea>
        </div>
        <div class="flex gap-3">
            <button type="submit" class="btn btn-filled">Update comment</button>
            <a href="javascript:history.back()" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</section>