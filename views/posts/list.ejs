<% layout('/shared/layouts/boilerplate.ejs') -%>

<% const qs = (page) => {
    const params = new URLSearchParams();
    if (search) params.set('search', search);
    params.set('page', page);
    return '/api/v1/blog?' + params.toString();
} %>

<section class="border-b border-line bg-paper">
    <div class="container-page py-14">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <span class="chip">$ ls posts</span>
                <h1 class="type-display mt-3">
                    <% if (search) { %>Results for “<span class="text-brand"><%= search %></span>”<% } else { %>All articles<% } %>
                </h1>
                <p class="type-body mt-2">
                    <%= totalPosts %> <%= totalPosts === 1 ? 'post' : 'posts' %><% if (search) { %> match your search<% } %>
                </p>
            </div>

            <form action="/api/v1/blog" method="get" class="w-full max-w-md">
                <label for="blog-search" class="sr-only">Search posts</label>
                <div class="relative">
                    <input id="blog-search" type="search" name="search" value="<%= search %>" placeholder="Search by title or description…"
                        data-search-input data-search-action="/api/v1/blog"
                        class="input pr-10">
                    <svg class="pointer-events-none absolute right-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
                    </svg>
                </div>
            </form>
        </div>

        <% if (isLoggedIn) { %>
            <div class="mt-8">
                <a href="/api/v1/post/create" class="btn btn-filled">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    New post
                </a>
            </div>
        <% } %>
    </div>
</section>

<section class="py-14">
    <div class="container-page">
        <% if (posts.length) { %>
            <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                <% posts.forEach((post) => { %>
                    <%- include('../shared/partials/postcard', { post }) %>
                <% }); %>
            </div>

            <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Pagination">
                <% if (hasPrevPage) { %>
                    <a href="<%= qs(currentPage - 1) %>" class="btn btn-ghost border border-line">‹ Previous</a>
                <% } else { %>
                    <span class="btn btn-ghost border border-line opacity-40">‹ Previous</span>
                <% } %>
                <span class="type-caption px-2">Page <%= currentPage %> of <%= totalPages %></span>
                <% if (hasNextPage) { %>
                    <a href="<%= qs(currentPage + 1) %>" class="btn btn-ghost border border-line">Next ›</a>
                <% } else { %>
                    <span class="btn btn-ghost border border-line opacity-40">Next ›</span>
                <% } %>
            </nav>
        <% } else { %>
            <%- include('../shared/partials/empty', {
                title: search ? 'No posts match your search' : 'No posts yet',
                message: search
                    ? 'Try a different keyword, or clear the search to browse everything.'
                    : 'Be the first to publish an article and grow the blog.',
                actionLabel: search ? 'Clear search' : 'Write a post',
                actionHref: search ? '/api/v1/blog' : '/api/v1/post/create'
            }) %>
        <% } %>
    </div>
</section>