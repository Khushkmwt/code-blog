<% layout('/shared/layouts/boilerplate.ejs') -%>

<%
    const authorName = post.author?.name || 'Anonymous';
    const authorInitials = authorName.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
    const isOwner = !!(currentUser && post.author?._id && currentUser._id &&
        post.author._id.toString() === currentUser._id.toString());
    const liked = !!(currentUser && post.likes && post.likes.length &&
        post.likes.some((id) => currentUser._id && id.toString() === currentUser._id.toString()));
    const likeCount = post.likes ? post.likes.length : 0;
%>

<article class="container-page py-12 md:py-16" style="max-width: 52rem;">
    <% if (isDraft) { %>
        <div class="mb-8 flex items-center gap-2 rounded-md border border-line bg-brand-soft/50 px-4 py-3">
            <span class="chip">Draft</span>
            <p class="type-caption">Only you can see this preview. <a href="/api/v1/post/update/<%= post._id %>" class="font-semibold text-brand hover:underline">Edit or publish</a>.</p>
        </div>
    <% } %>
    <span class="chip">$ cat posts/<%= post._id %></span>
    <h1 class="type-display mt-4"><%= post.title %></h1>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="avatar-initial h-10 w-10 text-sm"><%= authorInitials %></span>
            <div>
                <p class="text-sm font-semibold text-ink">
                    <a href="/api/v1/users/u/<%= post.author?.username %>" class="transition-colors hover:text-brand"><%= authorName %></a>
                </p>
                <p class="type-caption">
                    <time datetime="<%= post.createdAt?.toISOString() %>"><%= post.createdAt?.toDateString() %></time>
                    · <%= readMinutes %> min read
                </p>
            </div>
        </div>

        <% if (isOwner) { %>
            <div class="flex gap-2">
                <a href="/api/v1/post/update/<%= post._id %>" class="btn btn-outline">Edit</a>
                <form action="/api/v1/post/delete/<%= post._id %>" method="post" onsubmit="return confirm('Delete this post permanently?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        <% } %>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-4">
        <% if (currentUser) { %>
            <form action="/api/v1/post/like/<%= post._id %>" method="post" data-pending>
                <button type="submit" class="btn btn-ghost border border-line">
                    <svg class="h-4 w-4 <%= liked ? 'fill-brand text-brand' : 'text-muted' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <%= liked ? 'Liked' : 'Like' %> · <%= likeCount %>
                </button>
            </form>
        <% } else { %>
            <a href="/api/v1/users/login" class="btn btn-ghost border border-line" title="Log in to like this post">
                <svg class="h-4 w-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                <%= likeCount %> · Log in to like
            </a>
        <% } %>

        <span class="btn btn-ghost border border-line cursor-default">
            <svg class="h-4 w-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            <%= post.views || 0 %> views
        </span>

        <% if (currentUser) { %>
            <form action="/api/v1/users/bookmark/<%= post._id %>" method="post" data-pending>
                <button type="submit" class="btn btn-ghost border border-line" title="Save this post">
                    <svg class="h-4 w-4 <%= bookmarked ? 'fill-brand text-brand' : 'text-muted' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                    </svg>
                    <%= bookmarked ? 'Saved' : 'Save' %>
                </button>
            </form>
        <% } else { %>
            <a href="/api/v1/users/login" class="btn btn-ghost border border-line" title="Log in to save posts">
                <svg class="h-4 w-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                </svg>
                Save
            </a>
        <% } %>
    </div>

    <% if (post.tags && post.tags.length) { %>
        <div class="mt-6 flex flex-wrap gap-2">
            <% post.tags.forEach((tag) => { %>
                <a href="/api/v1/blog?tag=<%= tag %>" class="chip transition-colors hover:text-brand">#<%= tag %></a>
            <% }); %>
        </div>
    <% } %>

    <p class="mt-10 border-l-2 border-brand pl-5 text-xl leading-relaxed text-ink"><%= post.desc %></p>

    <div class="post-body mt-8"><%- contentHtml %></div>

    <!-- Comments -->
    <section class="mt-16 border-t border-line pt-10">
        <h2 class="type-h2 inline-flex items-center gap-3">
            Comments
            <span class="chip-teal"><%= comments.reduce((n, c) => n + 1 + (c.replies ? c.replies.length : 0), 0) %></span>
        </h2>

        <% if (comments && comments.length) { %>
            <ul class="mt-8 space-y-5">
                <% comments.forEach((comment) => {
                    const cName = comment.owner?.name || 'Anonymous';
                    const cInitials = cName.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
                    const isCommentMine = !!(currentUser && currentUser._id && comment.owner?._id &&
                        comment.owner._id.toString() === currentUser._id.toString());
                %>
                    <li class="card p-5">
                        <div class="flex items-start gap-4">
                            <span class="avatar-initial h-10 w-10 text-sm"><%= cInitials %></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-sm font-semibold text-ink"><%= cName %></p>
                                    <% if (isCommentMine) { %><span class="chip-teal">you</span><% } %>
                                    <time class="type-caption ml-auto" datetime="<%= comment.createdAt?.toISOString() %>"><%= comment.createdAt?.toDateString() %></time>
                                </div>
                                <p class="mt-2 text-sm leading-relaxed text-ink"><%= comment.content %></p>

                                <div class="mt-3 flex flex-wrap items-center gap-4">
                                    <% if (currentUser) { %>
                                        <details class="reply">
                                            <summary class="type-caption cursor-pointer font-semibold text-muted transition-colors hover:text-brand">
                                                Reply<%= comment.replies.length ? ` · ${comment.replies.length}` : '' %>
                                            </summary>
                                            <form action="/api/v1/post/comment/<%= post._id %>" method="POST" data-pending class="mt-3 grid gap-2">
                                                <input type="hidden" name="parent" value="<%= comment._id %>">
                                                <textarea name="comment" rows="2" class="input resize-y" placeholder="Write a reply…" required></textarea>
                                                <div class="flex gap-2">
                                                    <button type="submit" class="btn btn-filled btn-sm">Reply</button>
                                                    <button type="button" class="btn btn-outline btn-sm" onclick="this.closest('details').open = false">Cancel</button>
                                                </div>
                                            </form>
                                        </details>
                                    <% } else { %>
                                        <a href="/api/v1/users/login" class="type-caption font-semibold text-muted transition-colors hover:text-brand">Reply</a>
                                    <% } %>
                                    <% if (isCommentMine) { %>
                                        <span class="flex gap-4">
                                            <a href="/api/v1/post/comment/edit/<%= comment._id %>" class="text-xs font-semibold text-muted transition-colors hover:text-brand">Edit</a>
                                            <form action="/api/v1/post/comment/delete/<%= comment._id %>" method="post" onsubmit="return confirm('Delete this comment?');">
                                                <button type="submit" class="text-xs font-semibold text-danger transition-colors hover:opacity-80">Delete</button>
                                            </form>
                                        </span>
                                    <% } %>
                                </div>

                                <% if (comment.replies && comment.replies.length) { %>
                                    <div class="mt-4 space-y-3 border-l-2 border-line pl-4">
                                        <% comment.replies.forEach((reply) => {
                                            const rName = reply.owner?.name || 'Anonymous';
                                            const rInitials = rName.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
                                            const isReplyMine = !!(currentUser && currentUser._id && reply.owner?._id &&
                                                reply.owner._id.toString() === currentUser._id.toString());
                                        %>
                                            <div class="rounded-md bg-brand-soft/30 p-3">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="avatar-initial h-7 w-7 text-xs"><%= rInitials %></span>
                                                    <p class="text-sm font-semibold text-ink"><%= rName %></p>
                                                    <% if (isReplyMine) { %><span class="chip-teal">you</span><% } %>
                                                    <time class="type-caption ml-auto" datetime="<%= reply.createdAt?.toISOString() %>"><%= reply.createdAt?.toDateString() %></time>
                                                </div>
                                                <p class="mt-2 text-sm leading-relaxed text-ink"><%= reply.content %></p>
                                                <% if (isReplyMine) { %>
                                                    <div class="mt-3 flex gap-4">
                                                        <a href="/api/v1/post/comment/edit/<%= reply._id %>" class="text-xs font-semibold text-muted transition-colors hover:text-brand">Edit</a>
                                                        <form action="/api/v1/post/comment/delete/<%= reply._id %>" method="post" onsubmit="return confirm('Delete this reply?');">
                                                            <button type="submit" class="text-xs font-semibold text-danger transition-colors hover:opacity-80">Delete</button>
                                                        </form>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p class="type-body mt-6">No comments yet. Start the conversation below.</p>
        <% } %>

        <div class="mt-10">
            <% if (currentUser) { %>
                <form action="/api/v1/post/comment/<%= post._id %>" method="POST" data-pending class="card p-5">
                    <label for="comment" class="label">Add a comment</label>
                    <textarea id="comment" name="comment" rows="3" class="input resize-y" placeholder="Share what you think…" required></textarea>
                    <button type="submit" class="btn btn-filled mt-4">Post comment</button>
                </form>
            <% } else { %>
                <div class="card flex flex-wrap items-center justify-between gap-4 p-5">
                    <p class="type-body">Log in to join the conversation.</p>
                    <a href="/api/v1/users/login" class="btn btn-outline">Log in to comment</a>
                </div>
            <% } %>
        </div>
    </section>

    <% if (relatedPosts && relatedPosts.length) { %>
        <section class="mt-16 border-t border-line pt-10">
            <h2 class="type-h2">Related posts</h2>
            <div class="mt-6 grid gap-6 md:grid-cols-3">
                <% relatedPosts.forEach((related) => { %>
                    <%- include('../shared/partials/postcard', { post: related }) %>
                <% }); %>
            </div>
        </section>
    <% } %>
</article>