<% layout('/layouts/boilerplate.ejs') -%>

<section class="border-b border-line bg-paper">
    <div class="container-page py-16 md:py-20 text-center">
        <span class="chip">$ cat contact.txt</span>
        <h1 class="type-display mt-4">Let’s talk</h1>
        <p class="type-body mx-auto mt-4 max-w-2xl text-lg">
            Questions, feedback or a bug you’re stuck on? Drop us a line —
            we read everything and usually reply the same week.
        </p>
    </div>
</section>

<section class="border-t border-line py-16">
    <div class="container-page">
        <div class="grid gap-8 lg:grid-cols-5">
            <div class="lg:col-span-2">
                <div class="card h-full p-8">
                    <h2 class="type-h2">Reach us</h2>
                    <ul class="mt-6 space-y-5">
                        <li class="flex gap-3">
                            <span class="avatar-initial h-10 w-10 text-sm">@</span>
                            <div>
                                <p class="text-sm font-semibold text-ink">Email</p>
                                <a href="mailto:hello@code-blog.dev" class="type-caption transition-colors hover:text-brand">hello@code-blog.dev</a>
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="avatar-initial h-10 w-10 text-sm">⌂</span>
                            <div>
                                <p class="text-sm font-semibold text-ink">Address</p>
                                <p class="type-caption">Code-Blog HQ, Sector 12, Jaipur, Rajasthan</p>
                            </div>
                        </li>
                        <li class="flex gap-3">
                            <span class="avatar-initial h-10 w-10 text-sm">⌕</span>
                            <div>
                                <p class="text-sm font-semibold text-ink">Hours</p>
                                <p class="type-caption">Mon–Fri · 9:00 to 18:00 IST</p>
                            </div>
                        </li>
                    </ul>

                    <div class="mt-8 overflow-hidden rounded-md border border-line bg-[#1C1917] p-4 font-mono text-xs leading-relaxed text-[#EDE9DF]">
                        <code>
                            <div><span class="text-[#86EFAC]">$</span> ./contact.sh --send-message</div>
                            <div class="text-stone-400"># average reply time: 2 days</div>
                        </code>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-3">
                <form data-mailto action="#" method="post" data-pending class="card p-8">
                    <h2 class="type-h2">Send a message</h2>
                    <p class="type-body mt-2">This opens your email app with the message pre-filled.</p>

                    <div class="mt-6 grid gap-4 sm:grid-cols-2">
                        <div>
                            <label for="c-name" class="label">Your name</label>
                            <input id="c-name" name="name" type="text" required class="input" placeholder="Ada Lovelace">
                        </div>
                        <div>
                            <label for="c-email" class="label">Your email</label>
                            <input id="c-email" name="email" type="email" required class="input" placeholder="you@example.com">
                        </div>
                    </div>
                    <div class="mt-4">
                        <label for="c-message" class="label">Message</label>
                        <textarea id="c-message" name="message" rows="5" required class="input resize-y" placeholder="Tell us what’s on your mind…"></textarea>
                    </div>

                    <button type="submit" class="btn btn-filled mt-6">Send message →</button>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="border-t border-line bg-surface/60 py-16">
    <div class="container-page">
        <div class="text-center">
            <span class="chip">$ jobs --open</span>
            <h2 class="type-h2 mt-3">Work with us</h2>
            <p class="type-body mt-2">Remote-friendly roles, real problems, and a team that documents everything.</p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
            <div class="card p-8">
                <h3 class="type-h3">Software Engineer</h3>
                <p class="type-body mt-3">
                    Build and ship features across the platform. You’ll write code, review others’, and
                    turn post-mortems into blog posts.
                </p>
                <p class="type-caption mt-4 font-semibold uppercase tracking-wider">Requirements</p>
                <ul class="type-caption mt-2 list-disc space-y-1 pl-5">
                    <li>Proficiency in JavaScript/Node and web fundamentals</li>
                    <li>Comfort with SQL or Mongo, and git</li>
                    <li>Opinions about how things should be built</li>
                </ul>
                <a href="mailto:jobs@code-blog.dev?subject=Software%20Engineer" class="btn btn-outline mt-6">Apply now →</a>
            </div>
            <div class="card p-8">
                <h3 class="type-h3">Technical Writer</h3>
                <p class="type-body mt-3">
                    Turn debugging sessions into clear, practical tutorials. Bonus points for screenshots
                    of genuinely weird errors.
                </p>
                <p class="type-caption mt-4 font-semibold uppercase tracking-wider">Requirements</p>
                <ul class="type-caption mt-2 list-disc space-y-1 pl-5">
                    <li>You can explain a concept in under 500 words</li>
                    <li>You’ve shipped code and lived to write about it</li>
                    <li>Care about code samples that actually run</li>
                </ul>
                <a href="mailto:jobs@code-blog.dev?subject=Technical%20Writer" class="btn btn-outline mt-6">Apply now →</a>
            </div>
        </div>
    </div>
</section>