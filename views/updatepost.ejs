<% layout('layouts/boilerplate.ejs') -%>
<section class="container-page max-w-3xl py-12">
    <span class="chip">$ vim post.md</span>
    <h1 class="type-display mt-3">Edit post</h1>
    <p class="type-body mt-2">Update the details; the post keeps its comments and URL.</p>

    <form action="/api/v1/post/update/<%= post._id %>" method="POST" data-pending class="card mt-8 space-y-5 p-6 sm:p-8">
        <div>
            <label for="title" class="label">Title</label>
            <input id="title" name="title" type="text" required maxlength="120" value="<%= post.title %>"
                class="input font-display text-lg">
        </div>

        <div>
            <label for="desc" class="label">Short description</label>
            <input id="desc" name="desc" type="text" required maxlength="255" value="<%= post.desc %>"
                class="input">
            <p class="type-caption mt-1"><span data-count-for="desc"></span> characters</p>
        </div>

        <div>
            <label for="detail" class="label">Post detail</label>
            <textarea id="detail" name="detail" rows="12" required
                class="input resize-y font-mono text-sm"><%- post.detail %></textarea>
            <p class="type-caption mt-1">Rendered as-is in a monospace block.</p>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="btn btn-filled">Save changes</button>
            <a href="/api/v1/blog/show/<%= post._id %>" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</section>