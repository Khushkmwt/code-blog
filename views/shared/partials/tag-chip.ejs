<% if (tag) {
    const clearUrl = search ? `/api/v1/blog?search=${encodeURIComponent(search)}` : '/api/v1/blog';
%>
    <a href="<%= clearUrl %>" class="chip chip-filtered mr-2 no-underline" title="Clear tag filter">
        #<%= tag %>
        <svg class="ml-1 inline h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </a>
<% } %>