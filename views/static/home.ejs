<% layout('/shared/layouts/boilerplate.ejs') -%>

<% const initials = user?.name ? user.name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase() : '?' %>

<!-- Hero: code-grounded -->
<section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand/40 to-transparent"></div>
    <div class="container-page grid items-center gap-12 py-16 md:py-24 lg:grid-cols-2">
        <div>
            <span class="chip-teal">●&nbsp; By developers, for developers</span>
            <h1 class="type-display mt-5">
                Write. Debug.<br>
                <span class="italic text-brand">Ship.</span>
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
                Code-Blog is a home for practical tutorials, debugging war stories, and the tiny wins
                that make engineering fun. No fluff, just working code and the lessons behind it.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/api/v1/blog" class="btn btn-filled">Read the blog</a>
                <a href="/api/v1/post/create" class="btn btn-outline">Start writing</a>
            </div>

            <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-line pt-6">
                <div>
                    <dt class="type-caption">Posts</dt>
                    <dd class="font-display text-2xl font-semibold text-ink"><%= postsCount %></dd>
                </div>
                <div>
                    <dt class="type-caption">Writers</dt>
                    <dd class="font-display text-2xl font-semibold text-ink"><%= usersCount %></dd>
                </div>
                <div>
                    <dt class="type-caption">Since</dt>
                    <dd class="font-display text-2xl font-semibold text-ink">2016</dd>
                </div>
            </dl>
        </div>

        <div class="relative">
            <div class="overflow-hidden rounded-lg border border-line bg-term-bg shadow-lift">
                <div class="flex items-center gap-2 border-b border-white/10 bg-black/20 px-4 py-3">
                    <span class="h-3 w-3 rounded-full bg-term-red/80"></span>
                    <span class="h-3 w-3 rounded-full bg-term-amber/80"></span>
                    <span class="h-3 w-3 rounded-full bg-term-green/80"></span>
                    <span class="ml-2 text-xs text-stone-400">blog/feed.js</span>
                </div>
                <div class="overflow-x-auto p-5 font-mono text-sm leading-relaxed text-term-fg">
                    <code>
                        <div><span class="text-term-amber">const</span> <span class="text-term-blue">latestPosts</span> <span class="text-stone-500">=</span> <span class="text-term-amber">await</span> <span class="text-term-green">query</span><span class="text-stone-500">>(</span>&#123;</div>
                        <div class="pl-5"><span class="text-term-blue">order</span><span class="text-stone-500">:</span> <span class="text-term-orange">'newest'</span>,</div>
                        <div class="pl-5"><span class="text-term-blue">limit</span><span class="text-stone-500">:</span> <span class="text-term-orange">3</span>,</div>
                        <div class="pl-5"><span class="text-term-blue">by</span><span class="text-stone-500">:</span> <span class="text-term-orange">'developers'</span></div>
                        <div><span class="text-stone-500">&#125;)</span><span class="text-stone-500">;</span></div>
                        <div class="pt-2"><span class="text-term-violet">feed</span><span class="text-stone-500">.</span><span class="text-term-blue">pump</span><span class="text-stone-500">(</span>latestPosts<span class="text-stone-500">)</span><span class="text-stone-500">;</span></div>
                        <div class="pt-2 text-term-green">// <span data-typed data-phrases='["building what I wished existed","shipping the small wins","debugging in public"]'></span><span class="typed-caret text-brand">&nbsp;</span></div>
                    </code>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Follow feed -->
<% if (isLoggedIn && followFeed && followFeed.length) { %>
    <section class="border-t border-line py-16">
        <div class="container-page">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <span class="chip">$ ls posts --following</span>
                    <h2 class="type-h2 mt-3">From authors you follow</h2>
                </div>
                <a href="/api/v1/blog" class="btn btn-ghost">
                    View all
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </a>
            </div>
            <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                <% followFeed.forEach((post) => { %>
                    <%- include('../shared/partials/postcard', { post }) %>
                <% }); %>
            </div>
        </div>
    </section>
<% } %>

<!-- Latest posts -->
<section class="border-t border-line bg-surface/60 py-16">
    <div class="container-page">
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <span class="chip">$ ls posts --latest</span>
                <h2 class="type-h2 mt-3">Fresh from the blog</h2>
            </div>
            <a href="/api/v1/blog" class="btn btn-ghost">
                View all
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>
        </div>

        <% if (latestPosts && latestPosts.length) { %>
            <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                <% latestPosts.forEach((post) => { %>
                    <%- include('../shared/partials/postcard', { post }) %>
                <% }); %>
            </div>
        <% } else { %>
            <div class="mt-8">
                <%- include('../shared/partials/empty', {
                    title: 'No posts yet',
                    message: 'The blog is brand new — be the first to publish an article.',
                    actionLabel: 'Write a post',
                    actionHref: '/api/v1/post/create'
                }) %>
            </div>
        <% } %>
    </div>
</section>

<!-- Gallery -->
<section class="border-t border-line py-16">
    <div class="container-page">
        <div class="text-center">
            <span class="chip">From the gallery</span>
            <h2 class="type-h2 mt-3">Where the team builds</h2>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <img src="/assets/gallery1.jpg" alt="Workspace 1" class="h-64 w-full rounded-md border border-line object-cover">
            <img src="/assets/gallery4.jpg" alt="Workspace 2" class="h-64 w-full rounded-md border border-line object-cover">
            <img src="/assets/gallery5.jpg" alt="Workspace 3" class="h-64 w-full rounded-md border border-line object-cover">
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="border-t border-line bg-surface/60 py-16">
    <div class="container-page">
        <div class="text-center">
            <span class="chip">What readers say</span>
            <h2 class="type-h2 mt-3">Trusted by builders</h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
            <figure class="card p-6">
                <blockquote class="type-body font-medium text-ink">"I've never seen a dev blog this focused. Useful code, zero filler."</blockquote>
                <figcaption class="mt-4 flex items-center gap-3">
                    <span class="avatar-initial h-10 w-10 text-sm">SJ</span>
                    <div>
                        <p class="text-sm font-semibold text-ink">Sarah Johnson</p>
                        <p class="type-caption">Full-stack developer</p>
                    </div>
                </figcaption>
            </figure>
            <figure class="card p-6">
                <blockquote class="type-body font-medium text-ink">"The debugging stories saved me more than once. Highly recommend."</blockquote>
                <figcaption class="mt-4 flex items-center gap-3">
                    <span class="avatar-initial h-10 w-10 text-sm">AT</span>
                    <div>
                        <p class="text-sm font-semibold text-ink">Alex Thompson</p>
                        <p class="type-caption">Backend engineer</p>
                    </div>
                </figcaption>
            </figure>
            <figure class="card p-6">
                <blockquote class="type-body font-medium text-ink">"Great community, great tutorials. I've levelled up by reading alone."</blockquote>
                <figcaption class="mt-4 flex items-center gap-3">
                    <span class="avatar-initial h-10 w-10 text-sm">EC</span>
                    <div>
                        <p class="text-sm font-semibold text-ink">Emily Chen</p>
                        <p class="type-caption">Engineering student</p>
                    </div>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-16">
    <div class="container-page">
        <div class="card rounded-lg bg-brand-soft p-10 text-center sm:p-14">
            <h2 class="type-h2">Have a story worth sharing?</h2>
            <p class="mx-auto mt-3 max-w-lg text-muted">
                Create an account, publish your first article, and join the conversation.
            </p>
            <a href="/api/v1/users/register" class="btn btn-filled mt-8">Create your account</a>
        </div>
    </div>
</section>