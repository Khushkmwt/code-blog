<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Code-Blog — Where developers share' %></title>
    <meta name="description" content="Code-Blog — a home for practical tutorials, debugging war stories, and the small wins that make engineering fun.">
    <meta property="og:title" content="Code-Blog">
    <meta property="og:description" content="Practical tutorials, debugging war stories and the small wins that make engineering fun.">
    <meta property="og:type" content="website">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>
        try {
            var t = localStorage.getItem('theme');
            var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
    </script>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @custom-variant dark (&:where(.dark, .dark *));

        :root {
            --c-paper: #F7F4EF;
            --c-surface: #FFFFFF;
            --c-ink: #292524;
            --c-muted: #78716C;
            --c-brand: #C2410C;
            --c-brand-soft: #FDE5D0;
            --c-teal: #0F766E;
            --c-line: #E7E5E4;
            --c-danger: #B91C1C;
            --c-danger-soft: #FEE2E2;
            --c-btn-ink: #FFFFFF;
        }
        .dark {
            --c-paper: #1C1917;
            --c-surface: #292524;
            --c-ink: #EDE9DF;
            --c-muted: #A8A29E;
            --c-brand: #FB923C;
            --c-brand-soft: #431407;
            --c-teal: #2DD4BF;
            --c-line: #44403C;
            --c-danger: #F87171;
            --c-danger-soft: #3F1D1D;
            --c-btn-ink: #1C1917;
        }

        @theme inline {
            --color-paper: var(--c-paper);
            --color-surface: var(--c-surface);
            --color-ink: var(--c-ink);
            --color-muted: var(--c-muted);
            --color-brand: var(--c-brand);
            --color-brand-soft: var(--c-brand-soft);
            --color-teal: var(--c-teal);
            --color-line: var(--c-line);
            --color-danger: var(--c-danger);
            --color-danger-soft: var(--c-danger-soft);
            --color-btn-ink: var(--c-btn-ink);

            --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
            --font-display: "Fraunces", Georgia, "Times New Roman", serif;

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;

            --shadow-lift: 0 16px 40px -16px rgb(41 37 36 / 0.35);
        }

        @layer components {
            .type-display {
                @apply font-display text-4xl font-semibold leading-tight tracking-tight text-ink md:text-5xl;
            }
            .type-h2 {
                @apply font-display text-3xl font-semibold tracking-tight text-ink;
            }
            .type-h3 {
                @apply font-display text-xl font-semibold text-ink;
            }
            .type-body {
                @apply text-base leading-relaxed text-muted;
            }
            .type-caption {
                @apply text-sm text-muted;
            }
            .container-page {
                @apply mx-auto w-full max-w-6xl px-4 sm:px-6;
            }

            .btn {
                @apply inline-flex items-center justify-center gap-2 rounded-sm px-4 py-2 text-sm font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand/50 disabled:cursor-not-allowed disabled:opacity-60;
            }
            .btn-filled {
                @apply bg-brand text-btn-ink hover:bg-brand/90;
            }
            .btn-outline {
                @apply border border-brand text-brand hover:bg-brand-soft;
            }
            .btn-ghost {
                @apply text-ink hover:bg-ink/5;
            }
            .btn-danger {
                @apply border border-danger text-danger hover:bg-danger-soft;
            }

            .card {
                @apply rounded-md border border-line bg-surface;
            }
            .card-hover {
                @apply transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lift;
            }

            .input {
                @apply w-full rounded-sm border border-line bg-surface px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/25;
            }
            .label {
                @apply mb-1.5 block text-sm font-semibold text-ink;
            }

            .chip {
                @apply inline-flex items-center gap-1 rounded-sm bg-brand-soft px-2.5 py-0.5 text-xs font-semibold text-ink;
            }
            .chip-teal {
                @apply inline-flex items-center gap-1 rounded-sm bg-teal/10 px-2.5 py-0.5 text-xs font-semibold text-teal;
            }

            .avatar-initial {
                @apply flex shrink-0 items-center justify-center rounded-full bg-brand-soft font-display font-semibold text-ink;
            }
        }
    </style>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
    <%- include('navbar') %>
    <main class="flex flex-1 flex-col">
        <%- body -%>
    </main>
    <%- include('footer') %>
    <div id="toast-container" aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-[60] flex w-full max-w-sm flex-col gap-3 px-4 sm:px-0">
        <%- include('../partials/flash') %>
    </div>
    <script src="/index.js" defer></script>
</body>
</html>