<% layout('/shared/layouts/boilerplate.ejs') -%>
<section class="container-page py-14">
    <div class="mx-auto max-w-4xl overflow-hidden rounded-lg border border-line bg-surface shadow-lift md:grid md:grid-cols-2">
        <div class="hidden md:block">
            <%- include('../shared/partials/brandpanel') %>
        </div>

        <div class="p-8 sm:p-10">
            <h1 class="type-h2">Welcome back</h1>
            <p class="type-body mt-2">Log in to keep writing and commenting.</p>

            <form action="/api/v1/users/login" method="POST" data-pending class="mt-8 space-y-5">
                <div>
                    <label for="identifier" class="label">Email or username</label>
                    <input id="identifier" name="identifier" type="text" required autocomplete="username"
                        class="input" placeholder="you@example.com" autocapitalize="none" spellcheck="false">
                </div>

                <div>
                    <label for="password" class="label">Password</label>
                    <div class="relative">
                        <input id="password" name="password" type="password" required autocomplete="current-password"
                            class="input pr-10" placeholder="••••••••">
                        <button type="button" data-pw-toggle="password" aria-label="Show password" aria-pressed="false"
                            class="absolute right-2 top-1/2 -translate-y-1/2 rounded-sm p-1.5 text-muted transition-colors hover:text-ink">
                            <svg data-icon="eye" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            <svg data-icon="eye-off" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-filled w-full">Log in</button>
            </form>

            <p class="type-caption mt-8 text-center">
                New here?
                <a href="/api/v1/users/register" class="font-semibold text-brand transition-colors hover:text-brand/80">Create an account</a>
            </p>
        </div>
    </div>
</section>